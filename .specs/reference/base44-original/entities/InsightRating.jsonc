{
  "name": "InsightRating",
  "type": "object",
  "properties": {
    "insight_id": {
      "type": "string",
      "description": "ID \u00fanico do insight"
    },
    "category": {
      "type": "string",
      "enum": [
        "comportamento",
        "sexualidade",
        "financeira",
        "saude"
      ],
      "description": "Categoria do insight"
    },
    "rating": {
      "type": "number",
      "minimum": 1,
      "maximum": 5,
      "description": "Avalia\u00e7\u00e3o (1-5)"
    },
    "insight_title": {
      "type": "string",
      "description": "T\u00edtulo do insight avaliado"
    }
  },
  "required": [
    "insight_id",
    "category",
    "rating"
  ]
}