# Ambiente de desenvolvimento local.
# Segredo de verdade NAO mora aqui — vai em envs/env.dev.local (ignorado no git).

PROJECT_NAME=pai-presente
ENV=test
NODE_ENV=test

# Postgres local em contêiner descartável — estas credenciais não são segredo:
# o banco não é exposto para fora da rede do docker-compose.
POSTGRES_USER=paipresente
POSTGRES_PASSWORD=paipresente_local
POSTGRES_DB=pai_presente_test
POSTGRES_PORT=5433
DATABASE_URL=postgres://paipresente:paipresente_local@localhost:5433/pai_presente_test

API_PORT=3000
API_BASE_URL=http://localhost:3000
WEB_PORT=5173
WEB_BASE_URL=http://localhost:5173
# Ambiente do build do frontend (web.md §12): ausente ou desconhecido cai em producao.
APP_ENV=local

# IA — provedor trocável (ADR-001 D4). A chave vai em env.dev.local.
LLM_PROVIDER=anthropic
LLM_MODEL=
# Teste nunca chama o provedor de verdade: o valor existe so para o boot passar.
LLM_API_KEY=chave_de_teste_sem_valor

# Login por Google e Apple (ADR-001 D3). Os segredos vão em env.dev.local.
# Assina o token de acesso. Local e descartavel: NAO e o segredo de producao,
# que nasce novo em cada ambiente (security.md §4).
AUTH_JWT_SECRET=desenvolvimento_local_nao_e_segredo_32+
WEB_ORIGINS=http://localhost:5173

GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=
